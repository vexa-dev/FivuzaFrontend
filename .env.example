# Por defecto la API es del mismo origen (/api/v1): en desarrollo el proxy de
# Vite reenvia /api y /ws al backend, en produccion lo hace nginx. Abre el
# ERP en http://tenant1.localhost:5173 y el panel interno en
# http://public.localhost:5173/admin/login.

# Backend al que apunta el proxy de desarrollo (en Docker Compose: http://web:8000).
VITE_DEV_API_TARGET=http://localhost:8000

# Opcionales, solo para saltarse el proxy (flujo anterior):
# VITE_API_URL=http://public.localhost:8000/api/v1   # panel interno
# VITE_API_PORT=8000                                 # ERP del tenant

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
